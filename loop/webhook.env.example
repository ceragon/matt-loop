# 可选 webhook 完成通知 —— 供支持 webhook 唤醒的调用方（如 Grok Bot）使用。
# 默认关：LOOP_WEBHOOK_URL 与 LOOP_WEBHOOK_SECRET 两个都配了，dispatch 完成时才 POST。
# DS Bot 等用后台 job 完成通知的调用方无需配置本文件。
#
# 用法：把下面两行填进你运行 dispatch 的环境变量（勿把真实密钥提交进仓库）。
# dispatch 成功/报错都会 POST 结果 JSON 到该 URL，鉴权走 Authorization: Bearer <密钥>；
# 发失败不连累整轮，结果文件仍是事实源（result 记 webhook: off/sent/failed，
# 失败另记 webhook_error：HTTP 状态码或异常类名，不含 URL/密钥）。

LOOP_WEBHOOK_URL=https://<你的-webhook-端点>
LOOP_WEBHOOK_SECRET=<你的密钥>

# ---- 抽取后端（ADR-0005）----
# 默认 api：直连 OpenAI 兼容 chat completions 做裁剪＋抽取；pi 为显式备选。
# backend=api 时下面三个全必填、无默认；缺任何一个 dispatch 启动预检即报
# api_not_configured（只列变量名），不发主任务。密钥绝不进 stdout/result/stderr。
# 与 pi 网关复用同一把钥匙时，值指过去即可（如 LOOP_API_KEY="$PAW_GATEWAY_KEY"）。
LOOP_EXTRACT_BACKEND=api
LOOP_API_BASE=https://<你的网关>/v1
LOOP_API_KEY=<你的密钥>
LOOP_API_MODEL=<模型-id>
# 可选：输出上限，默认 32768；按模型档位调（请求超过模型上限时有些网关会报错）。
#LOOP_API_MAX_TOKENS=32768
# 走 pi 备选：设 LOOP_EXTRACT_BACKEND=pi（机器上要有 pi；--pi-model 仅该后端生效）。